{
  // HOI4 visual style data (copied to <data>/map/visual_style.json5 by hoi4_convert.py).
  // Feeds the GAME shader Hoi4/TerrainMap (Assets/Game/Shaders). Edit the copy in Hoi4Data
  // for live tweaking (hot reloaded), then copy good values back here.

  parameters: {
    // --- converted HOI4 textures ---
    _Hoi4TerrainIndex:  { texture: "gfx/map/terrain_index.png",  filter: "point",    wrap: "clamp", linear: true, mipmaps: false },
    _Hoi4AtlasDiffuse:  { texture: "gfx/map/atlas_diffuse.png",  filter: "trilinear", wrap: "clamp" },
    _Hoi4AtlasNormal:   { texture: "gfx/map/atlas_normal.png",   filter: "trilinear", wrap: "clamp", linear: true },
    _Hoi4Colormap:      { texture: "gfx/map/colormap.png",       filter: "bilinear", wrap: "clamp" },
    _Hoi4ColormapWater: { texture: "gfx/map/colormap_water.png", filter: "bilinear", wrap: "clamp" },
    _Hoi4Underwater:    { texture: "gfx/map/underwater.png",     filter: "trilinear", wrap: "repeat" },
    _Hoi4WorldNormal:   { texture: "gfx/map/world_normal.png",   filter: "bilinear", wrap: "clamp", linear: true, mipmaps: false },
    _Hoi4CityLights:    { texture: "gfx/map/citylights.png",     filter: "trilinear", wrap: "repeat" },
    _Hoi4SnowTex:       { texture: "gfx/map/snow.png",           filter: "trilinear", wrap: "repeat", linear: true },
    _Hoi4MudDiffuse:    { texture: "gfx/map/mud_diffuse.png",    filter: "trilinear", wrap: "repeat" },
    _Hoi4MudNormal:     { texture: "gfx/map/mud_normal.png",     filter: "trilinear", wrap: "repeat", linear: true },
    _Hoi4IceDiffuse:    { texture: "gfx/map/ice_diffuse.png",    filter: "trilinear", wrap: "repeat", linear: true },
    _Hoi4IceNoise:      { texture: "gfx/map/ice_noise.png",      filter: "trilinear", wrap: "repeat", linear: true },
    _Hoi4WaterLean1:    { texture: "gfx/map/water/lean1.png",      filter: "trilinear", wrap: "repeat", linear: true },
    _Hoi4WaterLean2:    { texture: "gfx/map/water/lean2.png",      filter: "trilinear", wrap: "repeat", linear: true },
    _Hoi4WaterSpec:     { texture: "gfx/map/water/water_spec.png", filter: "bilinear", wrap: "clamp", linear: true },
    _Hoi4WaterSky:      { texture: "gfx/map/water/water_sky.png",  filter: "bilinear", wrap: "repeat", mipmaps: false },

    // --- tuning (HOI4 constants.fxh values where they exist) ---
    _Hoi4TileFrequency:    { value: 128, type: "float" },
    _Hoi4ColormapStrength: { value: 0.75, type: "float" },
    _Hoi4PoliticalBlend:   { value: 0.65, type: "float" },

    _Hoi4SunDirection:     { value: [1.0, 1.0, -0.5, 0], type: "vector" }, // towards the sun, y up
    _Hoi4SunColor:         [1.0, 1.0, 1.0, 1.0],
    _Hoi4SunIntensity:     { value: 0.8, type: "float" },
    _Hoi4AmbientColor:     [0.42, 0.45, 0.5, 1.0],
    _Hoi4SpecularStrength: { value: 0.3, type: "float" },

    _Hoi4WaterLightness:          { value: 0.5, type: "float" },
    _Hoi4WaterDarken:             { value: 0.2, type: "float" },
    _Hoi4WaterFloorVisibility:    { value: 0.35, type: "float" }, // lit sea floor in shallow water
    _Hoi4WaterFloorRelief:        { value: 0.3, type: "float" },  // bathymetry relief on the sea floor
    _Hoi4WaterSurfaceColor:       [0.17, 0.23, 0.33, 1.0],         // optional tint over the sea (tuning aid)
    _Hoi4WaterSurfaceOpacity:     { value: 0.0, type: "float" },   // 0 = off; the sky reflection gives HOI4's blue-grey
    // pdxwater surface
    _Hoi4WaterWaveScale:          { value: 0.36, type: "float" },  // wave size: lower = bigger waves
    _Hoi4WaterWaveSpeed:          { value: 1.0, type: "float" },   // x HOI4 speed
    _Hoi4WaterWaveMask:           { value: 1.0, type: "float" },   // x HOI4 wave mask (open sea vs calm coasts)
    _Hoi4WaterFresnelBias:        { value: 0.5, type: "float" },   // sky reflection looking straight down (HOI4 0.5)
    _Hoi4WaterRefraction:         { value: 1.5, type: "float" },   // sea floor distortion, map px
    _Hoi4WaterGlint:              { value: 0.6, type: "float" },   // sun glint on the waves

    // City lights at night (masked by colormap alpha)
    _Hoi4CityLightsIntensity: { value: 5.5, type: "float" },     // HOI4 CITY_LIGHTS_INTENSITY
    _Hoi4CityLightsTiling:    { value: 0.09103, type: "float" }, // HOI4 CITY_LIGHTS_TILING (repeats per map px)

    // Gradient borders (political mode): [band thickness map px, edge blend, interior blend, rim darkening]
    _Hoi4Gradient:         { value: [10, 0.8, 0.25, 0.35], type: "vector" },
    // Map px per screen px where the color goes from border band only (zoomed in) to full fill (zoomed out)
    _Hoi4GradientFillZoom: { value: [0.5, 1.5, 0, 0], type: "vector" },
    _Hoi4CountryEdgeSoftness: { value: 1.0, type: "float" }, // 1 = gradient between country colors, 0 = near-sharp line
    // Supply map mode (F4): [smoothing radius map px, opacity over terrain]. Prototype supply_mapmode.py
    _Hoi4SupplyMap: { value: [5, 0.8, 0, 0], type: "vector" },
    // Snow on the terrain (HOI4 ApplySnow, Hoi4Weather.hlsl): [snow amount that reads as full snow (of 80),
    // map px per screen px where it goes from zoomed in (opacity 0.95) to zoomed out (0.2), edge blend map px].
    // Prototype weather/snow_render.py
    _Hoi4Snow:      { value: [40, 0.04, 0.25, 2], type: "vector" },
    _Hoi4SnowColor: { value: [0.46, 0.48, 0.69, 1.0], type: "vector" }, // HOI4 SNOW_COLOR (linear, so a vector, not a color), a = strength
    // Mud on the terrain (HOI4 GetMudColor): [strength a muddy province reads as (1 = solid brown ground)]
    _Hoi4Mud:       { value: [0.75, 0, 0, 0], type: "vector" },
    // Ice on water near snowy land (HOI4 ApplyIce): [how far out from the smooth coast it reaches, map px;
    // map px per screen px where it fades out zoomed out (HOI4 hides it sooner, about 0.08..0.29); north of this
    // share of the map height only (HOI4 0.74)]
    _Hoi4Ice:       { value: [6, 0.15, 0.6, 0.74], type: "vector" },
    // Ice look: [cover, 0 = HOI4's broken floes .. 1 = solid sheet; brightness, 1 = HOI4 ICE_COLOR;
    // falloff power, higher = thinner toward the reach, a raggeder fringe]
    _Hoi4IceLook:   { value: [0, 1.5, 3, 0], type: "vector" },
    // Falling weather when zoomed in (Hoi4/Precipitation, Hoi4WeatherSky): [opacity, screen px per map px where it
    // starts showing, where it is full, density]. Rain streaks, snowflakes, lightning over thunderstorms
    _Hoi4Precip:    { value: [0.6, 1.0, 2.0, 1.0], type: "vector" },
    // Fog of rain and thunderstorms in the same zoom range (Hoi4Fog.hlsl): [ground desaturation, haze alpha, puff
    // alpha, puff size map px]. Prototype weather/weather_fog.py. Off for now (all zero); tuned: [0.35, 0.3, 0.6, 50]
    _Hoi4Fog:       { value: [0, 0, 0, 50], type: "vector" },
  },

  // Mesh border classes (Archon MeshGeometry borders). HOI4 border.shader: strips are
  // BORDER_WIDTH (1.5) map px wide, the texture sets the visible line (U along tiled by
  // BORDER_TILE 0.4, V across). color [1,1,1,1] = use the texture's own colors.
  // minScreenWidth keeps the strip readable when zoomed out; fade = [hidden, visible] in
  // screen px per map px (HOI4 fades province borders out with camera distance).
  // Rough guide: ~1 = Europe on screen, ~3+ = a few countries, ~6+ = close in.
  // Classes come from the GAME classifier (Assets/Game/Scripts/Map/Hoi4BorderClassifier.cs).
  borders: {
    province:   { texture: "gfx/map/borders/province.png",   width: 1.5, minScreenWidth: 8, tile: 0.4, color: [1, 1, 1, 1], fade: [3.0, 5.0], order: 0 },
    sea:        { texture: "gfx/map/borders/sea.png",        width: 1.5, minScreenWidth: 8, tile: 0.4, color: [1, 1, 1, 1], fade: [3.0, 5.0], order: 1 },
    coast:      { visible: false },
    state:      { texture: "gfx/map/borders/state.png",      width: 1.5, minScreenWidth: 6, tile: 0.4, color: [1, 1, 1, 1], fade: [1.5, 2.5], order: 5 },
    sea_region: { texture: "gfx/map/borders/sea_region.png", width: 1.5, minScreenWidth: 5, tile: 0.4, color: [1, 1, 1, 1], order: 6 },
    impassable: { texture: "gfx/map/borders/impassable.png", width: 2.5, minScreenWidth: 8, tile: 0.2, color: [1, 1, 1, 1], fade: [2.0, 3.5], order: 8 },
    country:    { texture: "gfx/map/borders/country.png",    width: 1.5, minScreenWidth: 5, tile: 0.4, color: [1, 1, 1, 1], order: 10 },
    // Selection/hover outline (ENGINE highlight classes): the highlighted province's or country's
    // own smoothed arcs, drawn above every class. color multiplies the highlight color from the
    // UI (hover vs selection); its alpha is the opacity. alphaOnly: the texture gives only the
    // line shape (province.png is black). softness: 0 crisp edge, 1 soft glow falloff.
    // blend: "lighten" = Max blend, overlaps never add up (wide soft strips fold at tight corners).
    highlight_glow: { visible: true, width: 6.0, minScreenWidth: 16, softness: 1.0, blend: "lighten", color: [1, 1, 1, 0.45] },
    highlight:      { texture: "gfx/map/borders/province.png", alphaOnly: true, width: 1.5, minScreenWidth: 8, tile: 0.4, color: [1, 1, 1, 1] },
    // Railways (GAME Hoi4RailRenderer through Archon MapLineLayer, its own layer between rivers and
    // borders). Track from HOI4 gfx/models/supply/railroad.dds, one tile per level (rusty 1 .. steel 5).
    // Prototype Tools/prototypes/supply/render_rails.py, scale checked against an HOI4 screenshot:
    // 0.7 map px wide (the prototype matched an HOI4 screenshot at 0.4; wider reads better here), one tile per 0.7 map px (tile 1.43 repeats per map px, square tiles). fade = the unit counters'
    // (Hoi4UnitCounters fadeHiddenZoom 3, fadeVisibleZoom 5). rail_converting: a grey strip over captured
    // rail its new controller can't use yet (HOI4 greys it out), drawn by a second layer on top.
    rail_1: { texture: "gfx/map/rails/rail_1.png", width: 0.7, minScreenWidth: 1.5, tile: 1.43, color: [1, 1, 1, 1], fade: [3.0, 5.0], order: 1 },
    rail_2: { texture: "gfx/map/rails/rail_2.png", width: 0.7, minScreenWidth: 1.5, tile: 1.43, color: [1, 1, 1, 1], fade: [3.0, 5.0], order: 2 },
    rail_3: { texture: "gfx/map/rails/rail_3.png", width: 0.7, minScreenWidth: 1.5, tile: 1.43, color: [1, 1, 1, 1], fade: [3.0, 5.0], order: 3 },
    rail_4: { texture: "gfx/map/rails/rail_4.png", width: 0.7, minScreenWidth: 1.5, tile: 1.43, color: [1, 1, 1, 1], fade: [3.0, 5.0], order: 4 },
    rail_5: { texture: "gfx/map/rails/rail_5.png", width: 0.7, minScreenWidth: 1.5, tile: 1.43, color: [1, 1, 1, 1], fade: [3.0, 5.0], order: 5 },
    // Supply map mode (F4): HOI4's railway_map_arrow instead of the track, white and wider with each level (thin
    // texture for level 1, medium 2-3, thick 4-5: RAILWAY_MAP_ARROW_*_LEVEL_THRESHOLD), shown at every zoom.
    // Prototype Tools/prototypes/supply/supply_mapmode.py (scale checked against an HOI4 screenshot of Pomerania).
    rail_supply_1: { texture: "gfx/map/rails/supply_thin.png",   width: 0.9,  minScreenWidth: 3, tile: 1.25, color: [1, 1, 1, 1], order: 1 },
    rail_supply_2: { texture: "gfx/map/rails/supply_medium.png", width: 1.05, minScreenWidth: 4, tile: 1.25, color: [1, 1, 1, 1], order: 2 },
    rail_supply_3: { texture: "gfx/map/rails/supply_medium.png", width: 1.2,  minScreenWidth: 5, tile: 1.25, color: [1, 1, 1, 1], order: 3 },
    rail_supply_4: { texture: "gfx/map/rails/supply_thick.png",  width: 1.35, minScreenWidth: 6, tile: 1.25, color: [1, 1, 1, 1], order: 4 },
    rail_supply_5: { texture: "gfx/map/rails/supply_thick.png",  width: 1.5,  minScreenWidth: 7, tile: 1.25, color: [1, 1, 1, 1], order: 5 },
    rail_converting: { width: 0.7, minScreenWidth: 1, softness: 0.3, color: [0.3, 0.3, 0.3, 0.6], fade: [3.0, 5.0], order: 0 },
  },

  // Rivers (map/rivers.png, width level 1..9 per pixel from HOI4 rivers.bmp). Texture baked by the
  // converter from HOI4 RiverSurface textures: water in the middle, banks at the edges.
  // Width = width + widthPerLevel * level map px; minScreenWidth floors the widest-to-narrowest set.
  // Shader Hoi4/RiverMesh: the engine line pass plus HOI4's frozen rivers (snow where the river runs).
  rivers: { shader: "Hoi4/RiverMesh", texture: "gfx/map/rivers/river.png", width: 0.35, widthPerLevel: 0.12, minScreenWidth: 1, tile: 0.15, color: [1, 1, 1, 1], fade: [1.5, 2.5] },

  // Country name labels (Archon MapLabelRenderer). Font size in map px (maxHeight); labels below
  // minScreenHeight screen px grow up to maxScale times, smaller ones fade out. fade = [visible
  // below, hidden above] in screen px per map px (HOI4 hides country names at state zoom).
  labels: {
    font: "gfx/fonts/Oswald.ttf",
    color: [0.91, 0.9, 0.95, 1],
    shadowColor: [0.03, 0.03, 0.07, 0.8],
    shadowOffset: [0.04, 0.05],
    shadowSoftness: 0.6,
    minScreenHeight: 11,
    maxScale: 2.5,
    fade: [1.5, 2.5],
  },

  // State names (Archon region labels, Hoi4StateLabelSource): shown while the construction screen places a
  // building, fading in at the zoom where unit counters appear (counters: 3..5 screen px per map px).
  regionLabels: {
    font: "gfx/fonts/Oswald.ttf",
    color: [0.93, 0.93, 0.93, 0.95],
    shadowColor: [0.03, 0.03, 0.07, 0.85],
    shadowOffset: [0.04, 0.05],
    shadowSoftness: 0.6,
    minScreenHeight: 14,
    maxScale: 1.5,
    fade: [3, 5],
    fadeIn: true,
    maxHeight: 24,
  },

  // Haze and drifting clouds (Archon MapAtmosphereRenderer). Zoom ranges are [full at or below,
  // gone at or above] in screen px per map px (small = zoomed out); distances in map px.
  atmosphere: {
    hazeColor: [0.36, 0.42, 0.52],
    hazeMax: 0.3,
    hazeZoom: [0.3, 1.5],
    cloudColor: [0.95, 0.95, 0.97],
    cloudShade: [0.6, 0.64, 0.72],
    cloudCoverage: 0.42,     // 0 clear .. 1 overcast
    cloudSoftness: 0.22,
    cloudOpacity: 0.8,
    cloudScale: 1400,        // noise tile size: bigger = bigger cloud banks
    cloudWind: [5, 1.5],     // map px per second
    cloudZoom: [0.35, 0.9],
    cloudHeight: 60,         // parallax height above the map
    shadowStrength: 0.35,
    shadowOffset: [-40, 30],
    // Weather clouds (GAME Hoi4WeatherSky paints the mask: dark over thunderstorms, white over blizzards,
    // grey over rain and snow). maskZoom: gone by unit level (the counters fade in at 3..5); closer in, the falling
    // weather (_Hoi4Precip) takes over. Prototype weather/weather_clouds.py
    maskOpacity: 0.75,
    maskScale: 260,          // noise tile size, map px
    maskShadow: 0.5,         // ground shadow (more under dark clouds)
    maskZoom: [2, 3],
    maskSoftness: 0.45,      // wispy edges (the cloud banks use cloudSoftness)
    maskWarp: 60,            // map px: billowy outlines instead of the weather regions' shapes
  },

  // Day/night from game time. Toggle in game with toggleKey (Unity KeyCode name, "none" to disable).
  dayNight: {
    enabled: true,
    toggleKey: "N",
    opacity: 0.85,           // HOI4 NIGHT_OPACITY
    darkness: 0.5,           // HOI4 NIGHT_DARKNESS
    desaturation: 0.8,
    tint: [0.2, 0.7, 1.2],
    feather: 0.06,           // dusk band width
    greenwichX: 2793,        // HOI4 GMT_OFFSET (map px of longitude 0)
    latitudeRange: [0.17, 0.93], // HOI4 SOUTH/NORTH_POLE_OFFSET
    seasons: true,           // sun tilts with the date (long winter nights up north)
    fadeSeconds: 0.4,
  },
}
