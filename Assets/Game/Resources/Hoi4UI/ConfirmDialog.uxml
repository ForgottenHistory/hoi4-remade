<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- default_confirmation_popup (interface/popupwindow.gui): 480 x 382, centred -->
    <ui:VisualElement name="confirm-dialog" class="spr cd" picking-mode="Position">
        <ui:Label name="cd-title" class="hoi4-label center cd-title" picking-mode="Ignore" />
        <ui:ScrollView name="cd-scroll" class="cd-scroll" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto">
            <ui:Label name="cd-text" class="hoi4-label cd-text" picking-mode="Ignore" enable-rich-text="true" />
        </ui:ScrollView>
        <ui:VisualElement name="cd-cancel" class="spr hoi4-button cd-cancel" picking-mode="Position">
            <ui:Label class="hoi4-label center cd-button-text" text="Cancel" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="cd-ok" class="spr hoi4-button cd-ok" picking-mode="Position">
            <ui:Label class="hoi4-label center cd-button-text" text="OK" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
