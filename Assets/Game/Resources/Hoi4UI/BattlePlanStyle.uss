/* Battle Plans window (interface/battleplantools.gui), HOI4 pixels. The 641x79 bar holds the button slots;
   buttons are 35x34 at HOI4's coordinates (+36, the bar starts 36 left of the window). */
.bp-window { position: absolute; left: 50%; translate: -50% 0; bottom: 146px; width: 641px; height: 79px; } /* above the army cards and their play / stop buttons */
.bp-bg { position: absolute; left: 0; top: 0; width: 641px; height: 79px; }
.bp-title { position: absolute; left: 14px; top: 1px; height: 22px; font-size: 16px; color: rgb(255, 255, 255); -unity-text-align: middle-left; }
.bp-btn { position: absolute; top: 33px; width: 35px; height: 34px; }
.bp-front { left: 275px; }
.bp-offence { left: 312px; }
.bp-fallback { left: 391px; } /* btn_order_draw_fallback x 355 */
.bp-area { left: 427px; }     /* btn_area_defense x 391 */
/* The Defense window (battleplantools_area_defense_config_window at 250, -50; its background 15 to the left).
   Its guard toggles are 40x36, 40 apart from x 0, y 31 (set in code). */
.bp-defense { position: absolute; left: 286px; top: -50px; width: 332px; height: 79px; }
.bp-defense-bg { position: absolute; left: -15px; top: 0; width: 347px; height: 79px; }
.bp-defense-title { position: absolute; left: 5px; top: 4px; height: 23px; font-size: 16px; color: rgb(255, 255, 255); -unity-text-align: middle-left; }
.bp-guard { position: absolute; top: 31px; width: 40px; height: 36px; }
.bp-disabled { opacity: 0.45; }
.bp-assign { left: 473px; }   /* HOI4 battleplantools.gui btn_assign_units x 437, +36 like the others */
.bp-unassign { left: 508px; }
.bp-delete { left: 599px; }

.bp-labels { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.bp-line-label { position: absolute; white-space: nowrap; font-size: 15px; color: rgb(255, 255, 255);
    -unity-font-style: bold; -unity-text-outline-width: 1.5px; -unity-text-outline-color: rgb(30, 20, 14);
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8); }
