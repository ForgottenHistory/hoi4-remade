<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- One equipment to add a line for (countryproductionlineview.gui military_equipment_info_entry) -->
    <ui:VisualElement class="pp-entry" picking-mode="Position">
        <ui:VisualElement class="spr hoi4-button pp-bg" picking-mode="Ignore" />
        <ui:VisualElement name="pp-outdated" class="spr pp-outdated" picking-mode="Ignore" />
        <ui:VisualElement name="pp-picture" class="spr pp-picture" picking-mode="Ignore" />
        <ui:VisualElement name="pp-role" class="spr pp-role" picking-mode="Ignore" />
        <ui:Label name="pp-name" class="hoi4-label pp-name" picking-mode="Ignore" />
        <ui:Label name="pp-general" class="hoi4-label pp-general" picking-mode="Ignore" />
        <ui:VisualElement class="spr pp-cost-icon" picking-mode="Ignore" />
        <ui:Label name="pp-cost" class="hoi4-label gold pp-cost" picking-mode="Ignore" />
        <ui:VisualElement name="pp-resources" class="pp-resources" picking-mode="Ignore" />
        <!-- obsolete: green while current, dark once marked outdated (a click toggles). variant: drawn only -->
        <ui:VisualElement name="pp-obsolete" class="spr hoi4-button pp-obsolete" picking-mode="Position" />
        <ui:VisualElement class="spr pp-variant" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
