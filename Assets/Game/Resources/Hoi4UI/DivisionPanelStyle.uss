/* HOI4 selected-units list (interface/unitview.gui army_division_list_view), top left under the top bar.
   Coordinates are HOI4 pixel. Height is set by the view (it depends on the number of divisions). */
.division-panel {
    --sprite: "gfx/interface/unitpanel/window.png";
    position: absolute; left: 1px; top: 90px; width: 422px;
    -unity-slice-left: 64; -unity-slice-right: 64; -unity-slice-top: 64; -unity-slice-bottom: 64;
}

.dv-header { --sprite: "gfx/interface/unitpanel/header.png"; left: 7px; top: 8px; width: 392px; height: 35px; }
.dv-delete { --sprite: "gfx/interface/unitpanel/btn_delete.png"; left: 9px; top: 8px; width: 31px; height: 31px; }
.dv-title { left: 75px; top: 10px; width: 200px; height: 28px; font-size: 17px; }
.dv-select-half { --sprite: "gfx/interface/unitpanel/select_half.png"; left: 300px; top: 8px; width: 31px; height: 31px; }
.dv-hold { --sprite: "gfx/interface/unitpanel/hold.png"; left: 330px; top: 8px; width: 31px; height: 31px; }
.dv-close { --sprite: "gfx/interface/unitpanel/btn_close.png"; left: 362px; top: 8px; width: 31px; height: 31px; }

/* column heads: one stretched tile each */
.dv-sort { --sprite: "gfx/interface/unitpanel/sort.png"; top: 39px; height: 21px; -unity-slice-left: 6; -unity-slice-right: 6; }
.dv-sort-0 { left: 8px; width: 19px; }
.dv-sort-1 { left: 27px; width: 19px; }
.dv-sort-2 { left: 46px; width: 57px; }
.dv-sort-3 { left: 103px; width: 26px; }
.dv-sort-4 { left: 129px; width: 236px; }
.dv-sort-5 { left: 365px; width: 31px; }

.dv-list { position: absolute; left: 5px; top: 61px; width: 410px; }
/* thin dark scrollbar, no arrow buttons */
.dv-list .unity-scroller--vertical { width: 8px; background-color: rgba(10, 13, 13, 0.85); }
.dv-list .unity-scroller__low-button, .dv-list .unity-scroller__high-button { display: none; }
.dv-list .unity-scroller__slider { margin: 0; border-width: 0; background-color: rgba(0, 0, 0, 0); }
.dv-list .unity-base-slider__tracker { display: none; }
.dv-list .unity-base-slider__dragger {
    width: 8px; border-width: 0; border-radius: 2px; background-color: rgb(140, 158, 128);
}

.dv-footer { position: absolute; left: 5px; width: 396px; height: 54px; }
.dv-footer-bg { --sprite: "gfx/interface/unitpanel/unassigned_bg.png"; left: 0; top: 0; width: 396px; height: 54px; }
.dv-note { left: 17px; top: 4px; width: 362px; height: 46px; font-size: 13px; white-space: normal; }

/* one division entry */
.dv-card { height: 33px; flex-shrink: 0; }
.dv-card-bg { --sprite: "gfx/interface/unitpanel/entry_bg_1.png"; left: 2px; top: 0; width: 390px; height: 33px; }
.dv-bar { position: absolute; top: 3px; width: 6px; height: 28px; background-color: rgba(8, 8, 8, 0.9); }
.dv-bar-org { left: 11px; }
.dv-bar-str { left: 19px; }
.dv-bar-fill { position: absolute; left: 0; bottom: 0; width: 6px; }
.dv-bar-org .dv-bar-fill { background-color: rgb(115, 217, 77); }
.dv-bar-str .dv-bar-fill { background-color: rgb(242, 153, 51); }
.dv-bar-plan { left: 128px; }   /* unitview.gui bar_prepare, right of the experience level */
.dv-bar-plan .dv-bar-fill { background-color: rgb(81, 133, 156); }
.dv-info { --sprite: "gfx/interface/unitpanel/unitinfo.png"; left: 22px; top: 1px; width: 76px; height: 31px; }
.dv-icon { left: 21px; top: -6px; width: 76px; height: 42px; }
.dv-level { --sprite: "gfx/interface/unitpanel/level_0.png"; left: 99px; top: 3px; width: 27px; height: 27px; }
.dv-name { left: 138px; top: 1px; width: 215px; height: 18px; text-overflow: ellipsis; }
.dv-status { left: 138px; top: 17px; width: 215px; height: 14px; font-size: 11px; color: rgb(199, 209, 184); text-overflow: ellipsis; }
.dv-card-bg.dv-card-bg-off { --sprite: "gfx/interface/unitpanel/entry_bg_0.png"; }
.dv-card-close { --sprite: "gfx/interface/unitpanel/btn_close.png"; left: 357px; top: 1px; width: 31px; height: 31px; }
