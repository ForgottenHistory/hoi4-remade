/* Army cards along the bottom of the screen (interface/leadergroups.gui leader_groups_portrait_window).
   Coordinates are HOI4 pixel: a card is the 84x117 group frame with the 61x82 portrait inside it. */
.army-bar { position: absolute; left: 50%; translate: -50% 0; bottom: 0; flex-direction: row; align-items: flex-end; }
.army-list { flex-direction: row; align-items: flex-end; }
.army-slot { width: 84px; height: 117px; flex-shrink: 0; }

/* A card is 22px taller than the frame: the strip above it holds the battle plan play / stop buttons
   (leadergroups.gui: positions relative to the frame, which sits at x-1 y-12 of the group) */
.army-card { width: 84px; height: 139px; flex-shrink: 0; }
.ac-body { position: absolute; left: 0; top: 22px; width: 84px; height: 117px; }
.ac-exec-bg { position: absolute; left: 5px; top: 0; width: 78px; height: 26px; }
.ac-stop { position: absolute; left: 7px; top: 2px; width: 28px; height: 23px; }
.ac-play { position: absolute; left: 37px; top: 2px; width: 43px; height: 23px; }
.ac-play-anim { position: absolute; left: 37px; top: 3px; width: 44px; height: 20px; }
.ac-plan-value { position: absolute; left: 38px; top: 3px; width: 15px; height: 21px; }
.ac-portrait { position: absolute; left: 9px; top: 7px; width: 61px; height: 82px; background-size: 61px 82px; }
.ac-frame { position: absolute; left: 0; top: 0; width: 84px; height: 117px; }
.ac-count { position: absolute; left: 0; top: 86px; width: 84px; height: 16px; font-size: 15px; -unity-text-align: middle-center; color: rgb(235, 235, 225); }
.ac-disband { position: absolute; left: 63px; top: 5px; width: 16px; height: 16px; }
.ac-add { position: absolute; left: 9px; top: 7px; width: 61px; height: 83px; }
